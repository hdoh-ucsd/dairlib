<?xml version="1.0"?>
<!-- OIM single_obstacle scenario obstacle: the source scene's static
     0.05-half-extent cube (single_obstacle.xml obs_box), placed on the
     reference platform (top z = -0.029) at the start->goal midpoint. -->
<sdf version="1.7">
  <model name="single_obstacle_box">
    <static>true</static>
    <link name="obstacle">
      <pose>0.5 0.0 0.021 0 0 0</pose>
      <visual name="obstacle_visual">
        <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        <material><diffuse>0.85 0.35 0.1 1.0</diffuse></material>
      </visual>
      <collision name="obstacle_collision">
        <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
