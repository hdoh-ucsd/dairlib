        "//systems:robot_lcm_systems",
        "//systems/framework:lcm_driven_loop",
        "//systems/controllers/osc:operational_space_control",
        "//systems/controllers/osc:joint_space_tracking_data",
        "//systems/controllers/osc:rot_space_tracking_data",
        "//systems/controllers/osc:trans_space_tracking_data",
        "@drake//:drake_shared_library",
        "@c3//:libc3",
        "@gflags",
    ],
) for process in [
    "xarm6_sim",
    "xarm6_osc_controller",
    "xarm6_sampling_c3_controller",
]]

# Compatibility labels preserve existing `bazel build`, `bazel test`, and
# `bazel run` callers. Canonical files, targets, and produced binaries are all
# explicitly xArm6-named; direct bazel-bin paths must use the xarm6_* names.
[alias(
    name = legacy,
    actual = ":" + canonical,
) for legacy, canonical in {
    "xarm_process_common": "xarm6_process_common",
    "xarm_full_sampling_c3plus": "xarm6_full_sampling_c3plus",
    "xarm_sim": "xarm6_sim",
    "xarm_osc_controller": "xarm6_osc_controller",
    "xarm_sampling_c3_controller": "xarm6_sampling_c3_controller",
}.items()]

test_suite(
    name = "xarm_full_sampling_c3plus_test",
    tests = [":xarm6_full_sampling_c3plus_test"],
)
